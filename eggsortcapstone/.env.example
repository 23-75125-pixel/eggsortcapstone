# EggSort+ environment configuration
# Copy this file to .env and replace placeholder values as needed.

# Flask security and local URL
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=0
PUBLIC_BASE_URL=http://127.0.0.1:5000
AUTO_START_SORTING_ON_LOGIN=1

# Google OAuth - required for administrator Google sign-in
GOOGLE_AUTH_CLOCK_SKEW_SECONDS=120
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL=administrator@example.com
ADMIN_GOOGLE_SUB=

# Staff invitation email (optional)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Camera
CAMERA_INDEX=0
CAMERA_BACKEND=dshow
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
CAMERA_JPEG_QUALITY=72

# YOLO - best.pt in the project root is used when this is left blank/removed
YOLO_MODEL_PATH=C:/path/to/eggsortcapstone/best.pt
YOLO_CONFIDENCE=0.25
YOLO_IMAGE_SIZE=512
# Consecutive frames that must agree before one egg quality is locked
CAMERA_QUALITY_SAMPLES=3

# ESP32 - leave the port blank to auto-detect one USB serial controller
ESP32_BAUD_RATE=115200
ESP32_PORT=
