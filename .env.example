# Flask: generate once with:
# .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value
FLASK_DEBUG=0
PUBLIC_BASE_URL=http://127.0.0.1:5000

# OpenCV camera selection. External webcams are commonly index 1.
CAMERA_INDEX=0
CAMERA_BACKEND=dshow
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
CAMERA_JPEG_QUALITY=60
CAMERA_STREAM_WIDTH=960
CAMERA_STREAM_HEIGHT=540
YOLO_IMAGE_SIZE=512
YOLO_RESULT_MAX_AGE_MS=750
YOLO_MAX_FPS=5
YOLO_CPU_THREADS=2

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# The only account allowed to use Google sign-in.
ADMIN_EMAIL=capstonecutie1@gmail.com

# Leave blank for the first sign-in. Afterward run:
# .\.venv\Scripts\flask.exe --app app show-admin-google-id
# Copy the printed value here and restart the app.
ADMIN_GOOGLE_SUB=

# Gmail SMTP. Use a Google App Password, never your normal Google password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=your-sender@gmail.com
MAIL_PASSWORD=replace-with-a-16-character-google-app-password
MAIL_FROM=your-sender@gmail.com
