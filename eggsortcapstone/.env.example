# EggSort+ environment configuration
# Copy this file to .env and replace placeholder values as needed.

# Flask security and local URL
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=0
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Google OAuth - required for administrator Google sign-in
# Temporary allowance for this PC's incorrect clock. Use 120 after syncing.
GOOGLE_AUTH_CLOCK_SKEW_SECONDS=120

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL=23-75125@g.batstate-u.edu.ph
ADMIN_GOOGLE_SUB=

# Staff invitation email (optional)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Camera settings
CAMERA_INDEX=0
CAMERA_BACKEND=dshow
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
CAMERA_JPEG_QUALITY=72

# YOLO settings. best.pt must exist at this path.
YOLO_MODEL_PATH=C:/path/to/eggsortcapstone/best.pt
YOLO_CONFIDENCE=0.25
YOLO_IMAGE_SIZE=512

# Arduino settings. Leave blank to auto-detect one load-cell device.
ARDUINO_BAUD_RATE=9600
ARDUINO_LOADCELL_PORT=
ARDUINO_STOPPER_PORT=
